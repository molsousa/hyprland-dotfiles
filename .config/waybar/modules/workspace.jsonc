{
  "hyprland/workspaces": {
    "format": "{icon} {windows}",
    "format-icons": {
      "urgent": "",
      "active": "", // focused workspace on current monitor
      "visible": "", // focused workspace on other monitors
      "default": "",
      "empty": "" // persistent (created by this plugin)
    },
    "on-scroll-up": "hyprctl dispatch split-cycleworkspaces -1",
    "on-scroll-down": "hyprctl dispatch split-cycleworkspaces +1",
    "on-click": "activate",
    "persistent-workspaces": {
      "*": 6
    },
    "window-rewrite-default": "󰊠",
    "window-rewrite": {
      // --- Work ---
      "alacritty": "",
      "libreoffice": "󰏆",
      "keepassxc": "󰯄",
      "firefox": "󰈹",
      "code": "",
      "azahar": "",
      "joplin": "󰹕",
      "mousepad": "󱓧",
      "thunderbird": "",
      "kdevelop": "",
      "eog": "󰋩",
      "packettracer": "󰑩",
      "gaphor": "",
      "cpu-x": "",
      // --- Apps ---
      "discord": "",
      "spotify": "",
      "org.kde.kdeconnect.app": "󰦉",
      "org.qbittorrent.qBittorrent": "󰘿",
      "unity": "",
      // --- Graphics & Visual ---
      "xdg-desktop-portal-gtk": "",
      "thunar": "",
      "yazi": "󰇥",
      "imv": "󰄄",
      "swappy": "󰄄",
      "org.gnome.FileRoller": "",
      "vlc": "󰕼",
      "mpv": "󰕼",
      "dbeaver": "",
      "netbeans": "",
      // --- System ---
      "blueman-manager": "",
      "pavucontrol": "󱕂",
      "nm-connection-editor": "󰐻",
      "virtualbox": "",
      "polkit-gnome": "󰌾",
      "timeshift": "󱇻",
      // --- Tool ---
      "nwg-look": "󰒓",
      "qt5ct": "󰒓",
      "qt6ct": "󰒓",
      "designer": "󰒓",
      "linguist": "󰒓",
      "assistant": "󰒓",
      "pixeltool": "󰒓",
      "qdbusviewer": "󰒓"
    },
    "format-icons": {
      "active": "󰮯",
      "special": "󱁂",
      "default": "󰊠",
      "urgent": "󰧵",
      "empty": ""
    },
    "show-special": true,
    "all-outputs": false
  }
}
